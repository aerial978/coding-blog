# Example environment configuration for automated tests.
# Copy this file to .env.test and adapt values if necessary.

APP_ENV=test
APP_URL=http://localhost/coding-blog
LOG_LEVEL=DEBUG

DB_HOST=localhost
DB_NAME_TEST=coding-blog_test
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Mailer used during automated tests
MAILER_TRANSPORT=dummy
MAIL_FROM_EMAIL=no-reply@example.test
MAIL_FROM_NAME="Coding Blog Test"

# Fictitious value: no real Cloudflare secret is required for tests
TURNSTILE_SECRET=test-turnstile-secret