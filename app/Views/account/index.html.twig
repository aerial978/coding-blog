{% extends "templates/layouts/admin.html.twig" %}

{% block title %}{{ title }}{% endblock %}

{% block content %}

{% include 'templates/partials/_flashes.html.twig' with { flashes: flashes } %}

<div class="account-page">
    <h1 class="mb-4">Mon compte</h1>
    {# Personal information #}
    <section class="card mb-4" aria-labelledby="personal-information-title">
        <div class="card-body">
            <h2 class="h5 card-title mb-3" id="personal-information-title">
                Informations personnelles
            </h2>

            <dl class="row mb-0">
                <dt class="col-sm-4">Nom d’utilisateur</dt>
                <dd class="col-sm-8">{{ account.username ?? 'Non renseigné' }}</dd>

                <dt class="col-sm-4">Adresse e-mail</dt>
                <dd class="col-sm-8">{{ account.email ?? 'Non renseignée' }}</dd>
            </dl>

            <hr class="my-4">

            <h3 class="h6 mb-3">Modifier mon nom d’utilisateur</h3>

            <form id="accountUsernameForm" action="{{ base_path }}account/username" method="post">
                <input
                    type="hidden"
                    name="csrf_token"
                    value="{{ csrf_token }}"
                >

                <div class="mb-3">
                    <label for="username" class="form-label">
                        Nouveau nom d’utilisateur
                    </label>

                    <input
                        type="text"
                        class="form-control"
                        id="username"
                        name="username"
                        value="{{ account.username }}"
                        minlength="3"
                        maxlength="20"
                        pattern="[A-Za-z0-9_]{3,20}"
                        autocomplete="username"
                        required
                        aria-describedby="username-help"
                    >

                    <div id="username_error"></div>

                    <div id="username-help" class="form-text">
                        Entre 3 et 20 caractères : lettres, chiffres et tiret bas (_).
                        Au moins une lettre est obligatoire.
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">
                    Enregistrer le nom d’utilisateur
                </button>
            </form>
        </div>
    </section>

    {# Profile picture #}
    <section class="card mb-4" aria-labelledby="profile-picture-title">
        <div class="card-body">
            <h2 class="h5 card-title mb-3" id="profile-picture-title">
                Photo de profil
            </h2>

            <div class="d-flex align-items-center gap-3">
                <i
                    class="bi bi-person-circle fs-1 text-secondary"
                    aria-hidden="true"
                ></i>

                <p class="text-muted mb-0">
                    Aucune photo de profil définie.
                </p>
            </div>
        </div>
    </section>

    {# Account security #}
    <section class="card mb-4" aria-labelledby="account-security-title">
        <div class="card-body">
            <h2 class="h5 card-title mb-3" id="account-security-title">
                Sécurité du compte
            </h2>

            <dl class="row mb-0">
                <dt class="col-sm-4">Authentification 2FA par e-mail</dt>
                <dd class="col-sm-8">
                    {% if account.email_2fa_enabled %}
                        <span class="badge text-bg-success">Activée</span>
                    {% else %}
                        <span class="badge text-bg-secondary">Désactivée</span>
                    {% endif %}
                </dd>
            </dl>
        </div>
    </section>

    {# Account information #}
    <section class="card mb-4" aria-labelledby="account-information-title">
        <div class="card-body">
            <h2 class="h5 card-title mb-3" id="account-information-title">
                Informations du compte
            </h2>

            <dl class="row mb-0">
                <dt class="col-sm-4">Rôle</dt>
                <dd class="col-sm-8">
                    {{ account.role ?? 'Non renseigné' }}
                </dd>

                <dt class="col-sm-4">Statut</dt>
                <dd class="col-sm-8">
                    {{ account.status ?? 'Non renseigné' }}
                </dd>

                <dt class="col-sm-4">Date de création</dt>
                <dd class="col-sm-8">
                    {% if account.created_at %}
                        {{ account.created_at|date('d/m/Y à H:i') }}
                    {% else %}
                        Non renseignée
                    {% endif %}
                </dd>
            </dl>
        </div>
    </section>
</div>

{% endblock %}

{% block page_scripts %}
    <script
        type="module"
        src="{{ base_path }}assets/js/security/validation.account-username.js"
    ></script>
{% endblock %}
