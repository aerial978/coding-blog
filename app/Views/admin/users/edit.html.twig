{% extends "templates/layouts/base.html.twig" %}

{% block title %}{{ title }}{% endblock %}

{% block content %}

<section>
    <h2>Modifier un utilisateur</h2>

    {% include 'templates/partials/_flashes.html.twig' with { flashes: flashes } %}

    <form id="adminUserEditForm" method="post" action="{{ base_path }}admin/users/{{ user.user_id }}/edit" novalidate>

        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

        <div>
            <label for="user_id">ID</label>
            <input
                type="text"
                id="user_id"
                value="{{ user.user_id }}"
                readonly
            >
        </div>

        <div>
            <label for="username">Nom d’utilisateur</label>
            <input
                type="text"
                id="username"
                name="username"
                value="{{ user.username }}"
                required
            >
            <div id="username_error"></div>
        </div>

        <div>
            <label for="email">Adresse e-mail</label>
            <input
                type="email"
                id="email"
                value="{{ user.email }}"
                size="40"
                readonly
            >
        </div>

        <div>
            <label for="role">Rôle</label>

            {% if is_own_account %}
                <input
                    type="text"
                    id="role"
                    value="{{ user.role }}"
                    readonly
                >
            {% else %}
                <select id="role" name="role">
                    <option
                        value="MEMBER"
                        {% if user.role == 'MEMBER' %}selected{% endif %}
                    >
                        MEMBER
                    </option>
                    <option
                        value="ADMIN"
                        {% if user.role == 'ADMIN' %}selected{% endif %}
                    >
                        ADMIN
                    </option>
                </select>
            {% endif %}
        </div>

        <div>
            <label for="status">Statut</label>

            {% if is_own_account or user.status == 'inactive' %}
                <input
                    type="text"
                    id="status"
                    value="{{ user.status }}"
                    readonly
                >
            {% else %}
                <select id="status" name="status">
                    <option
                        value="active"
                        {% if user.status == 'active' %}selected{% endif %}
                    >
                        active
                    </option>
                    <option
                        value="disabled"
                        {% if user.status == 'disabled' %}selected{% endif %}
                    >
                        disabled
                    </option>
                </select>
            {% endif %}
        </div>

        <div>
            <label for="created_at">Date de création</label>
            <input
                type="text"
                id="created_at"
                value="{{ user.created_at }}"
                readonly
            >
        </div>

        <button type="submit">
            Enregistrer les modifications
        </button>
    </form>

    <a href="{{ base_path }}admin/users">
        Retour à la liste des utilisateurs
    </a>
</section>

{% block page_scripts %}
<script
    type="module"
    src="{{ base_path }}assets/js/admin/validation.user-edit.js"
></script>
{% endblock %}

{% endblock %}