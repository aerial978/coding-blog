{% extends "templates/layouts/admin.html.twig" %}

{% block title %}{{ title }}{% endblock %}

{% block content %}

<section>
    <h2 class="mb-4">
        {{ user.role == 'ADMIN' or user.status == 'inactive' ? 'Consulter un utilisateur' : 'Modifier un utilisateur' }}
    </h2>

    {% include 'templates/partials/_flashes.html.twig' with { flashes: flashes } %}

    <div class="card shadow-sm w-100">
        <div class="card-body p-4">

            <form
                id="adminUserEditForm"
                method="post"
                action="{{ base_path }}admin/users/{{ user.user_id }}/edit"
                novalidate
            >
                <input
                    type="hidden"
                    name="csrf_token"
                    value="{{ csrf_token }}"
                >

                <div class="row g-3">

                    {# Identifiant #}
                    <div class="col-12 col-md-6">
                        <label for="user_id" class="form-label">
                            ID
                        </label>
                        <input
                            type="text"
                            id="user_id"
                            class="form-control bg-body-secondary"
                            value="{{ user.user_id }}"
                            readonly
                        >
                    </div>

                    {# Nom d'utilisateur : non modifiable #}
                    <div class="col-12 col-md-6">
                        <label for="username" class="form-label">
                            Nom d’utilisateur
                        </label>
                        <input
                            type="text"
                            id="username"
                            class="form-control bg-body-secondary"
                            value="{{ user.username }}"
                            readonly
                        >
                    </div>

                    {# Adresse e-mail #}
                    <div class="col-12">
                        <label for="email" class="form-label">
                            Adresse e-mail
                        </label>
                        <input
                            type="email"
                            id="email"
                            class="form-control bg-body-secondary"
                            value="{{ user.email }}"
                            readonly
                        >
                    </div>

                    {# Rôle : aucune promotion vers ADMIN #}
                    <div class="col-12 col-md-6">
                        <label for="role" class="form-label">
                            Rôle
                        </label>

                        <input
                            type="text"
                            id="role"
                            class="form-control bg-body-secondary"
                            value="{{ user.role }}"
                            readonly
                        >

                        {% if user.role == 'MEMBER' %}
                            <input
                                type="hidden"
                                name="role"
                                value="MEMBER"
                            >
                        {% endif %}
                    </div>

                    {# Statut #}
                    <div class="col-12 col-md-6">
                        <label for="status" class="form-label">
                            Statut
                        </label>

                        {% if user.role == 'ADMIN' or user.status == 'inactive' %}
                            <input
                                type="text"
                                id="status"
                                class="form-control bg-body-secondary"
                                value="{{ user.status }}"
                                readonly
                            >
                        {% else %}
                            <select
                                id="status"
                                name="status"
                                class="form-select"
                            >
                                <option
                                    value="active"
                                    {% if user.status == 'active' %}selected{% endif %}
                                >
                                    active
                                </option>
                                <option
                                    value="disabled"
                                    {% if user.status == 'disabled' %}selected{% endif %}
                                >
                                    disabled
                                </option>
                            </select>
                        {% endif %}
                    </div>

                    {# Date de création #}
                    <div class="col-12">
                        <label for="created_at" class="form-label">
                            Date de création
                        </label>
                        <input
                            type="text"
                            id="created_at"
                            class="form-control bg-body-secondary"
                            value="{{ user.created_at }}"
                            readonly
                        >
                    </div>

                </div>

                {# Actions du formulaire #}
                <div class="d-flex flex-wrap gap-2 mt-4">

                    {% if user.role == 'MEMBER' and user.status != 'inactive' %}
                        <button type="submit" class="btn btn-primary">
                            Enregistrer les modifications
                        </button>
                    {% endif %}

                    <a
                        href="{{ base_path }}admin/users"
                        class="btn btn-outline-secondary"
                    >
                        Retour à la liste
                    </a>
                </div>

            </form>

        </div>
    </div>
</section>

{% endblock %}

{% block page_scripts %}
    {% if user.role != 'ADMIN' %}
        <script
            type="module"
            src="{{ base_path }}assets/js/admin/validation.user-edit.js"
        ></script>
    {% endif %}
{% endblock %}
