{% extends "templates/layouts/admin.html.twig" %}

{% block title %}{{ title }}{% endblock %}

{% block content %}

{% include 'templates/partials/_flashes.html.twig' with { flashes: flashes } %}

<section>
    <h2>Gestion des utilisateurs</h2>

    {% if users is empty %}
        <p>Aucun utilisateur enregistré.</p>
    {% else %}
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle text-nowrap">
                <thead>
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Nom d’utilisateur</th>
                        <th scope="col">Adresse e-mail</th>
                        <th scope="col">Rôle</th>
                        <th scope="col">Statut</th>
                        <th scope="col">Date de création</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr>
                            <td>{{ user.user_id }}</td>
                            <td>{{ user.username }}</td>
                            <td>{{ user.email }}</td>
                            <td>{{ user.role }}</td>
                            <td>{{ user.status }}</td>
                            <td>{{ user.created_at }}</td>
                            <td>
                                <a href="{{ base_path }}admin/users/{{ user.user_id }}/edit">
                                    {{ user.role == 'ADMIN' or user.status == 'inactive' ? 'Consulter' : 'Modifier' }}
                                </a>

                                {% if user.can_delete %}
                                    <button
                                        type="button"
                                        class="btn btn-sm btn-outline-danger ms-2"
                                        data-delete-user-id="{{ user.user_id }}"
                                        data-delete-url="{{ base_path }}admin/users/{{ user.user_id }}/delete"
                                        data-delete-username="{{ user.username }}"
                                        data-delete-email="{{ user.email }}"
                                    >
                                        Supprimer
                                    </button>
                                {% else %}
                                    <span
                                        class="d-inline-block delete-disabled-wrapper"
                                        tabindex="0"
                                        title="{{ user.delete_disabled_reason }}"
                                        aria-label="{{ user.delete_disabled_reason }}"
                                    >
                                        <button
                                            type="button"
                                            class="btn btn-sm btn-outline-danger ms-2"
                                            disabled
                                            aria-label="Suppression de {{ user.username }} indisponible : {{ user.delete_disabled_reason }}"
                                            style="pointer-events: none;"
                                        >
                                            Supprimer
                                        </button>
                                    </span>
                                    <span class="delete-disabled-reason">
                                        {{ user.delete_disabled_reason }}
                                    </span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</section>

<dialog
    id="delete-user-dialog"
    class="delete-user-dialog"
    aria-labelledby="delete-user-dialog-title"
    aria-describedby="delete-user-dialog-description"
>
    <h3 id="delete-user-dialog-title">
        Supprimer définitivement un utilisateur
    </h3>

    <p id="delete-user-dialog-description">
        Vous êtes sur le point de supprimer définitivement le compte suivant :
    </p>

    <dl>
        <dt>Nom d’utilisateur</dt>
        <dd id="delete-user-username"></dd>

        <dt>Adresse e-mail</dt>
        <dd id="delete-user-email"></dd>
    </dl>

    <p>
        <strong>Cette action est irréversible.</strong>
    </p>

    <form
        id="delete-user-form"
        method="post"
        action=""
    >
        <input
            type="hidden"
            name="csrf_token"
            value="{{ csrf_token }}"
        >

        <div class="d-flex justify-content-end gap-2">
            <button
                type="button"
                id="cancel-user-delete"
                class="btn btn-outline-secondary"
            >
                Annuler
            </button>

            <button
                type="submit"
                class="btn btn-danger"
            >
                Supprimer définitivement
            </button>
        </div>
    </form>
</dialog>

{% endblock %}

{% block page_scripts %}
    <script
        type="module"
        src="{{ base_path }}assets/js/admin/user-delete.js"
    ></script>
{% endblock %}