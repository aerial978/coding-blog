# ============================================================
# Application
# ============================================================

# Application environment.
# Use "test" to load .env.test instead of .env.
APP_ENV=local

# Base URL of the application
APP_URL=http://localhost/coding-blog

# Allowed values:
# DEBUG, INFO, NOTICE, WARNING, ERROR, CRITICAL, ALERT, EMERGENCY
LOG_LEVEL=DEBUG


# ============================================================
# Database
# ============================================================

DB_HOST=localhost
DB_NAME=coding-blog
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Database used when APP_ENV=test
DB_NAME_TEST=coding-blog_test


# ============================================================
# Mail
# ============================================================

# Allowed values: mailjet, dummy
MAILER_TRANSPORT=dummy

MAIL_FROM_EMAIL=no-reply@example.test
MAIL_FROM_NAME="Coding Blog"

# Required only when MAILER_TRANSPORT=mailjet
MJ_APIKEY_PUBLIC=your-mailjet-public-key
MJ_APIKEY_PRIVATE=your-mailjet-private-key


# ============================================================
# Form security
# ============================================================

HONEYPOT_FIELD=contact_number

# Minimum time, in seconds, before a submitted form is accepted
MIN_FORM_DELAY=10

# Maximum form lifetime, in seconds
MAX_FORM_DELAY=1800


# ============================================================
# Cloudflare Turnstile
# ============================================================

TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET=your-turnstile-secret


# ============================================================
# Google OAuth
# ============================================================

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

GOOGLE_REDIRECT_URI=http://localhost/coding-blog/auth/google/callback

GOOGLE_OAUTH_SCOPES="openid email profile"